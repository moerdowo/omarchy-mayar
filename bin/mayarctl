#!/usr/bin/env bash
# mayarctl — read a Mayar merchant account from the command line: balance,
# paid transactions, unpaid transactions.
#
# All network and credential handling lives here rather than in Panel.qml, so
# the same behavior is available from a terminal and there is one place where
# the API contract and the key storage are implemented.
#
#   mayarctl status              print JSON for the bar widget (never fails)
#   mayarctl balance             print JSON balance
#   mayarctl paid   [-n N]       print JSON paid transactions
#   mayarctl unpaid [-n N]       print JSON unpaid transactions
#   mayarctl set-key             read a key on stdin, verify it, store it
#   mayarctl logout              remove the stored key
#   mayarctl auth                print JSON describing where the key comes from
#   mayarctl refresh             drop the response cache
#
# On credentials: Mayar has no merchant login endpoint. API v2 authenticates
# with `Authorization: Bearer <api-key>` and nothing else — the only login in
# the docs is a magic link that logs your *customers* into their portal. So
# there is nothing to log in to and no `login` command: the key is typed into
# the panel, which pipes it to `set-key`, which verifies it against /balances
# and puts it in the login keyring so it never sits in a dotfile. `set-key`
# reads stdin and prompts for nothing, so it is equally usable headlessly:
#
#   printf %s "$KEY" | mayarctl set-key
#
# The api-key path (MAYAR_API_KEY, or the config file) stays available for
# machines where no keyring is unlocked.
#
# The key is never a command-line argument — not to this script, and not to
# curl. /proc/<pid>/cmdline is world-readable, so an argument is readable by
# every user on the machine for as long as the process lives; curl gets the
# Authorization header from a config file on stdin instead.
#
# Every path this script reads or writes goes through bin/mayarfs, which does
# the whole open / read / write / replace / delete lifecycle on descriptors
# rather than on names. See the header there for why that cannot be done here.

# No `set -e`. The panel polls `status` and renders whatever JSON comes back;
# a failed API call is a state to report, not a reason to exit and hand the
# panel an empty stdout.
set -uo pipefail

# Byte semantics, not the user's locale. Two things below count characters and
# both of them mean bytes: the ceiling on a response body, and the `read -N`
# that pulls a length-prefixed payload back from the cache helper. Not exported
# — this is about how bash measures its own strings, not about how curl and jq
# talk to the world.
LC_ALL=C

SERVICE=mayar
ACCOUNT=api-key
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/mayar"
CONFIG_FILE="$CONFIG_DIR/apikey"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-mayar"

# How long a cached response stays good. The bar widget polls far more often
# than the numbers change, and every poll is a request against a rate limit the
# docs do not publish — so the widget's cadence is decoupled from the API's.
CACHE_TTL="${MAYAR_CACHE_TTL:-60}"

# Ceiling on a single API response. A body is held in a shell variable, walked
# by jq several times, written to the cache and finally collected in QML, so an
# unbounded response is unbounded memory in four places at once — and the row
# limits in the panel only apply long after all of that. Real Mayar payloads are
# single-digit kilobytes; 256 KiB is room to spare and still small enough that a
# hostile or broken endpoint cannot matter.
MAX_BYTES="${MAYAR_MAX_BYTES:-262144}"
[[ $MAX_BYTES =~ ^[0-9]+$ ]] && ((MAX_BYTES >= 1024 && MAX_BYTES <= 8388608)) ||
  MAX_BYTES=262144

# Sandbox keys only work against api.mayar.io, production keys only against
# api.mayar.id. Selected by environment so a single install can be pointed at
# either without editing anything.
case "${MAYAR_ENV:-production}" in
sandbox) API_BASE="https://api.mayar.io/hl/v2" ;;
*) API_BASE="https://api.mayar.id/hl/v2" ;;
esac

die() {
  echo "mayarctl: $*" >&2
  exit 1
}

need() { command -v "$1" >/dev/null 2>&1 || die "missing required command '$1'"; }
need curl
need jq
need python3

# ----------------------------------------------------------------- safe paths
#
# Every path this script reads or writes is one another process could have got
# to first — and the part a 0700 directory does not cover is that the other
# process can be running as this same user, in which case the mode bits have
# nothing to say. A symlink where the key file is expected sends whatever it
# points at into an Authorization header; a FIFO there wedges the bar on a read
# that never returns; a symlink in the cache directory turns a cache write into
# a write to a file of someone else's choosing.
#
# Checking a path and then opening it does not stop any of that, however careful
# the check is. They are two operations against a *name*, and between them the
# name can be made to mean something else — the entry replaced, or any directory
# on the way to it. The check then describes something that is no longer what
# gets opened.
#
# Bash cannot close that gap. It has no redirection that opens O_NOFOLLOW or
# O_NONBLOCK, and no openat, renameat or unlinkat — every builtin it has, and
# every coreutil it can call, starts again from the name. So the filesystem
# lives in bin/mayarfs instead: it walks a path once, a component at a time,
# each step an openat on the descriptor of the component before it and each
# descriptor validated by fstat, and then performs the entire lifecycle
# relative to that descriptor. A name is never resolved twice. Read the header
# in bin/mayarfs for the detail.

HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P) || HERE=.
MAYARFS="$HERE/mayarfs"
[[ -f $MAYARFS ]] || die "missing helper '$MAYARFS' — the plugin is incomplete"

# The key file. Capped at 4 KiB so a file of surprising size cannot pull more
# than that in, and refused outright if it is group- or world-writable: anyone
# who can rewrite it chooses which server the key goes to. The secret crosses
# one pipe, from a process this script started — never an argument, never the
# environment, never a temporary file.
read_private_key() {
  python3 -- "$MAYARFS" read-key "$1" 4096 2>/dev/null
}

# ---------------------------------------------------------------- credentials

# Precedence is deliberate: an explicit environment variable beats the keyring,
# so a one-off `MAYAR_API_KEY=... mayarctl paid` works without disturbing what
# is stored. The config file is last — it is the fallback for headless machines
# where no keyring daemon is running.
key_source=""

# The answer comes back in API_KEY rather than on stdout. A caller writing
# `k=$(api_key)` would fork a subshell and pipe the secret through it for no
# reason, and would also throw away everything else the call worked out — which
# source it came from, and the file read below.
API_KEY=""

# Reading the file starts a helper, and `status` asks for the key once per
# endpoint. Ask the filesystem once per run.
key_file_read=0
key_file_value=""

api_key() {
  local k
  API_KEY=""

  # Whitespace is stripped from every source, not just the file: a key pasted
  # with a trailing newline is the same key, and a stray newline would break
  # the curl config line the header is written on below.
  if [[ -n ${MAYAR_API_KEY:-} ]]; then
    k=${MAYAR_API_KEY//[[:space:]]/}
    if [[ -n $k ]]; then
      key_source=env
      API_KEY=$k
      return 0
    fi
  fi

  if command -v secret-tool >/dev/null 2>&1; then
    k=$(secret-tool lookup service "$SERVICE" account "$ACCOUNT" 2>/dev/null)
    k=${k//[[:space:]]/}
    if [[ -n $k ]]; then
      key_source=keyring
      API_KEY=$k
      return 0
    fi
  fi

  if ((!key_file_read)); then
    key_file_value=$(read_private_key "$CONFIG_FILE") || key_file_value=""
    key_file_read=1
  fi
  k=${key_file_value//[[:space:]]/}
  if [[ -n $k ]]; then
    key_source=file
    API_KEY=$k
    return 0
  fi

  key_source=none
  return 1
}

# Reads the key on stdin — never an argument — verifies it against /balances,
# and only then stores it in the login keyring. Prints one JSON object either
# way so the panel can tell "stored" from "rejected" without parsing prose.
#
# Verifying first matters: a key that was never going to work should not land
# in the keyring, where the panel would report it as rejected on every poll
# from then on with nothing to point at.
do_set_key() {
  local key resp code saved

  IFS= read -r key || true
  key=${key//[[:space:]]/}
  if [[ -z $key ]]; then
    jq -nc '{ok:false,error:"no key given"}'
    return 1
  fi

  if ! command -v secret-tool >/dev/null 2>&1; then
    jq -nc --arg f "$CONFIG_FILE" \
      '{ok:false,error:("secret-tool is not installed — set MAYAR_API_KEY, or write the key to " + $f)}'
    return 1
  fi

  # Set it in this shell rather than as a `VAR=x func` prefix: bash scopes such
  # a prefix to the function only outside POSIX mode, which is a difference the
  # verification step should not depend on.
  saved=${MAYAR_API_KEY:-}
  MAYAR_API_KEY="$key"
  resp=$(api_get "/balances")
  code=$?
  MAYAR_API_KEY=$saved
  [[ -z $saved ]] && unset MAYAR_API_KEY

  if ((code != 0)); then
    jq -nc --arg e "$(jq -r '.error // "request failed"' <<<"$resp" 2>/dev/null)" \
      '{ok:false,error:$e}'
    return 1
  fi

  # secret-tool takes the value on stdin, so the key is not in its argv either.
  if ! printf '%s' "$key" |
    secret-tool store --label="Mayar API key" service "$SERVICE" account "$ACCOUNT"; then
    jq -nc '{ok:false,error:"could not write to the keyring"}'
    return 1
  fi

  cache_drop
  # `shadowed` is not a failure: the key was stored, but MAYAR_API_KEY outranks
  # the keyring, so the panel would keep reading the old one and look like the
  # save silently did nothing. It says so instead.
  jq -nc --argjson shadowed "$([[ -n ${MAYAR_API_KEY:-} ]] && echo true || echo false)" \
    '{ok:true, source:"keyring", shadowed:$shadowed}'
}

do_logout() {
  local cleared=0
  if command -v secret-tool >/dev/null 2>&1; then
    secret-tool clear service "$SERVICE" account "$ACCOUNT" 2>/dev/null && cleared=1
  fi
  cache_drop
  if ((cleared)); then
    echo "Removed the stored key and dropped the cache."
  else
    echo "No key was stored in the keyring; dropped the cache."
  fi
  # Advisory only: this decides whether to print a sentence, and nothing is
  # opened, read or removed on the strength of it.
  [[ -e $CONFIG_FILE || -L $CONFIG_FILE ]] &&
    echo "Note: $CONFIG_FILE still exists and will still be used. Delete it too if you meant to."
  [[ -n ${MAYAR_API_KEY:-} ]] &&
    echo "Note: MAYAR_API_KEY is set in this environment and takes precedence."
  return 0
}

# ------------------------------------------------------------------- requests

# Echoes a JSON body on success. On failure echoes {"error": "..."} and returns
# non-zero, so callers can distinguish the two without parsing prose.
api_get() {
  local path=$1 key body http sep esc
  api_key || {
    echo '{"error":"no API key"}'
    return 1
  }
  key=$API_KEY

  # The key reaches curl through a config file on stdin, never through argv.
  # /proc/<pid>/cmdline is world-readable, so `-H "Authorization: Bearer ..."`
  # publishes the key to every user on the machine for as long as the request
  # runs — a `ps` or a read of /proc at the right moment is the whole attack.
  # printf is a bash builtin, so writing the config spawns no process carrying
  # it either. Backslashes and quotes are escaped because curl unescapes them
  # inside a quoted config value; a Mayar key contains neither, but the
  # escaping is what makes that not need to be true.
  esc=${key//\\/\\\\}
  esc=${esc//\"/\\\"}

  # -w appends the status after the body; split on a separator that cannot
  # appear in JSON so a body containing newlines still parses.
  sep=$'\x1e'

  # Deadlines bound how long a response may take; they say nothing about how
  # big it may be, and this body is about to be held in a variable, walked by
  # jq, cached and shipped to the panel. Two ceilings, because one of them can
  # be lied to:
  #
  #   --max-filesize refuses a body whose Content-Length already says it is too
  #   big, so the usual oversized response is never transferred at all; and
  #
  #   head -c is the one that cannot be talked out of it. It closes the pipe the
  #   moment the ceiling is reached and curl dies of SIGPIPE, so this shell holds
  #   at most MAX_BYTES + 1 bytes whatever the server does — chunked, lying about
  #   its length, or streaming for the whole --max-time window.
  #
  # The +1 is what makes "too big" detectable rather than silently truncated: a
  # body at exactly the ceiling still leaves a byte for the overrun to show up in.
  body=$(printf 'header = "Authorization: Bearer %s"\n' "$esc" |
    curl -sS --config - \
      --proto '=https' \
      --connect-timeout 5 --max-time 15 \
      --max-filesize "$MAX_BYTES" \
      -H "Accept: application/json" \
      -w "${sep}%{http_code}" \
      "${API_BASE}${path}" 2>&1 |
    head -c "$((MAX_BYTES + 1))")

  # Bytes, not characters — which is what LC_ALL=C above buys: outside it,
  # ${#body} counts characters and would measure a multibyte body short.
  if ((${#body} > MAX_BYTES)); then
    jq -nc --argjson n "$MAX_BYTES" \
      '{error:("response was larger than " + ($n | tostring) + " bytes — refused")}'
    return 1
  fi

  if [[ $body != *"$sep"* ]]; then
    # curl failed before it got a response — the message is the whole output.
    # `--max-filesize` tripping lands here too, which is the right place for it.
    jq -nc --arg m "${body:-network error}" '{error:$m}'
    return 1
  fi

  http=${body##*"$sep"}
  body=${body%"$sep"*}

  if [[ $http != 2* ]]; then
    local msg
    msg=$(echo "$body" | jq -r '.messages // .message // empty' 2>/dev/null)
    [[ -n $msg ]] || msg="HTTP $http"
    # 401 is the one worth naming, because it means "the key needs replacing",
    # not "try again later".
    [[ $http == 401 || $http == 403 ]] && msg="unauthorized — check the API key ($msg)"
    jq -nc --arg m "$msg" --argjson s "$http" '{error:$m,status:$s}'
    return 1
  fi

  if ! echo "$body" | jq -e . >/dev/null 2>&1; then
    jq -nc '{error:"response was not JSON"}'
    return 1
  fi

  printf '%s' "$body"
}

# Cached bodies carry customer names and amounts, so the cache lives in a
# directory nothing else can write to — and the directory is not merely created
# but opened and validated, because `mkdir -p` is perfectly happy to accept a
# directory, or a symlink to one, that somebody else put there first.
#
# bin/mayarfs is started once and kept alive as a coprocess for the length of
# this run. It opens the cache directory once, on a descriptor it validated, and
# every entry after that is read, written, replaced and removed relative to that
# one descriptor. The directory is never named again, so there is no second
# resolution for anyone to redirect: a swap between two cache operations reaches
# a name nothing is looking at any more.
#
# A cache that cannot be made private is not used at all. Every read then simply
# misses and the panel goes to the network, which is slower and still correct.
cache_ok=""
cache_r=""
cache_w=""

cache_ready() {
  [[ -n $cache_ok ]] && return "$cache_ok"
  cache_ok=1

  local hello
  coproc CACHEFS { exec python3 -- "$MAYARFS" cache "$CACHE_DIR" 2>/dev/null; }
  cache_r=${CACHEFS[0]}
  cache_w=${CACHEFS[1]}

  # The helper says READY only once the directory is open, private and swept.
  # Anything else — a refusal, a crash, silence — leaves the cache off.
  IFS= read -r -t 10 -u "$cache_r" hello 2>/dev/null || hello=""
  if [[ $hello != READY ]]; then
    cache_stop
    return 1
  fi
  cache_ok=0
  return 0
}

cache_stop() {
  [[ -n $cache_r ]] && exec {cache_r}<&-
  [[ -n $cache_w ]] && exec {cache_w}>&-
  cache_r=""
  cache_w=""
  [[ -n ${CACHEFS_PID:-} ]] && wait "$CACHEFS_PID" 2>/dev/null
  return 0
}

# After a protocol failure the stream is no longer at a known boundary, so
# nothing further can be read off it and meant: the cache is done for this run.
cache_fail() {
  cache_stop
  cache_ok=1
  return 1
}

# Set by cache_read. The age is not a separate stat of the path afterwards — it
# comes from the same fstat, on the same descriptor, that established the bytes
# were a regular file of ours before they were read.
CACHED=""
CACHED_AGE=-1

# Every exchange with the helper is bounded by -t: the panel is waiting on this,
# and a helper that stopped answering must not become a bar that stopped
# updating.
cache_read() {
  local name=$1 max=$2 status age len
  CACHED=""
  CACHED_AGE=-1
  cache_ready || return 1
  printf 'READ %s %s\n' "$name" "$max" >&"$cache_w" 2>/dev/null || { cache_fail; return 1; }
  IFS=' ' read -r -t 10 -u "$cache_r" status age len 2>/dev/null || { cache_fail; return 1; }
  [[ $status == OK ]] || return 1
  ((len > 0)) || return 1
  # -N takes exactly that many bytes and stops, newlines and all — a cached
  # body is JSON and may well contain them.
  IFS= read -r -N "$len" -t 10 -u "$cache_r" CACHED 2>/dev/null || { cache_fail; return 1; }
  CACHED_AGE=$age
  return 0
}

cache_write() {
  local name=$1 data=$2 status
  cache_ready || return 1
  printf 'WRITE %s %s\n%s' "$name" "${#data}" "$data" >&"$cache_w" 2>/dev/null ||
    { cache_fail; return 1; }
  IFS= read -r -t 10 -u "$cache_r" status 2>/dev/null || { cache_fail; return 1; }
  [[ $status == OK ]]
}

# The helper empties and removes the directory through the descriptors it has
# held all along, then exits — so this shuts the coprocess down rather than
# leaving it holding a descriptor to a directory that is gone.
cache_drop() {
  local reply
  if cache_ready; then
    printf 'DROP\n' >&"$cache_w" 2>/dev/null
    IFS= read -r -t 10 -u "$cache_r" reply 2>/dev/null
  fi
  cache_stop
  cache_ok=""
  return 0
}

# api_get through a TTL cache, keyed by path. A stale entry is preferred over
# an error: if the request fails and something cached exists, the panel keeps
# showing the last known numbers instead of blanking out.
#
# The answer lands in RESP rather than on stdout. `$(cached_get …)` would run
# all of this in a subshell, and the coprocess — the whole point of which is one
# validated descriptor for the run — would then be started, used once and thrown
# away for each endpoint in turn.
RESP=""

cached_get() {
  local path=$1 name cached="" merged
  name=$(printf '%s' "${MAYAR_ENV:-production}$path" | tr -c 'a-zA-Z0-9' '_').json

  if [[ ${FORCE:-0} != 1 ]] && cache_read "$name" "$MAX_BYTES"; then
    cached=$CACHED
    if ((CACHED_AGE >= 0 && CACHED_AGE < CACHE_TTL)); then
      RESP=$cached
      return 0
    fi
  fi

  RESP=$(api_get "$path")
  if (($? == 0)); then
    cache_write "$name" "$RESP"
    return 0
  fi

  # A forced read skipped the lookup above, so it has nothing in hand yet.
  if [[ -z $cached ]] && cache_read "$name" "$MAX_BYTES"; then
    cached=$CACHED
  fi

  if [[ -n $cached ]]; then
    # Mark it stale so the panel can say so rather than showing old numbers as
    # if they were current.
    merged=$(jq -c --arg e "$(jq -r '.error // "request failed"' <<<"$RESP" 2>/dev/null)" \
      '. + {stale:true, staleReason:$e}' <<<"$cached" 2>/dev/null)
    if [[ -n $merged ]]; then
      RESP=$merged
      return 0
    fi
  fi

  return 1
}

# --------------------------------------------------------------------- shapes

# Normalise the two transaction endpoints into one row shape. They disagree on
# almost everything: paid rows carry `credit` and a `status` of settled/pending,
# unpaid rows carry `amount` and a `status` of active/expired, and only unpaid
# rows have a payment URL. The panel should not have to know that.
normalise_paid() {
  jq -c '[.data[]? | {
    id,
    kind: "paid",
    amount: (.credit // 0),
    status: (.status // "unknown"),
    createdAt: (.createdAt // null),
    method: (.paymentMethod // null),
    type: (.balanceHistoryType // .type // null),
    customer: (.customer.name // .customer.email // null),
    label: (.paymentLink.name // null),
    url: null,
    fee: ([.fee[]?.debit // 0] | add // 0)
  }]'
}

normalise_unpaid() {
  jq -c '[.data[]? | {
    id,
    kind: "unpaid",
    amount: (.amount // 0),
    status: (.status // "unknown"),
    createdAt: (.createdAt // null),
    method: null,
    type: (.type // null),
    customer: (.customer.name // .customer.email // null),
    label: (.paymentLink.name // .paymentLink.description // null),
    url: (.paymentUrl // null),
    fee: 0
  }]'
}

# ------------------------------------------------------------------- commands

# Clamp to the API's documented ceiling rather than letting it 400 on us.
limit_arg() {
  local n=${1:-10}
  [[ $n =~ ^[0-9]+$ ]] || n=10
  ((n < 1)) && n=1
  ((n > 50)) && n=50
  echo "$n"
}

# cached_get answers in RESP, so these print it and pass its status on.
cmd_balance() {
  local rc
  cached_get "/balances"
  rc=$?
  printf '%s' "$RESP"
  return "$rc"
}

cmd_paid() {
  local n rc
  n=$(limit_arg "${1:-10}")
  cached_get "/transactions?limit=${n}"
  rc=$?
  printf '%s' "$RESP"
  return "$rc"
}

cmd_unpaid() {
  local n rc
  n=$(limit_arg "${1:-10}")
  cached_get "/transactions/unpaid?limit=${n}"
  rc=$?
  printf '%s' "$RESP"
  return "$rc"
}

cmd_auth() {
  local ok=false
  api_key && ok=true
  jq -nc \
    --argjson authenticated "$ok" \
    --arg source "$key_source" \
    --arg env "${MAYAR_ENV:-production}" \
    --arg base "$API_BASE" \
    --argjson keyring "$(command -v secret-tool >/dev/null 2>&1 && echo true || echo false)" \
    '{authenticated:$authenticated, source:$source, env:$env, apiBase:$base, keyringAvailable:$keyring}'
}

# The panel's single entry point. Always prints one valid JSON object on
# stdout and always exits 0 — an unauthenticated or offline account is a state
# to render, not an error to propagate.
cmd_status() {
  local n bal paid unpaid
  n=$(limit_arg "${1:-10}")

  if ! api_key; then
    jq -nc \
      --arg env "${MAYAR_ENV:-production}" \
      --argjson keyring "$(command -v secret-tool >/dev/null 2>&1 && echo true || echo false)" \
      '{hasKey:false, authenticated:false, source:"none", env:$env, keyringAvailable:$keyring,
        balance:null, paid:[], unpaid:[], error:null, stale:false}'
    return 0
  fi

  # Called in line rather than through $(…): the three of them share one cache
  # coprocess, and a subshell each would mean a descriptor each.
  cached_get "/balances"
  bal=$RESP
  cached_get "/transactions?limit=${n}"
  paid=$RESP
  cached_get "/transactions/unpaid?limit=${n}"
  unpaid=$RESP

  # First real error wins for the headline; the panel shows one line, not three.
  local err
  err=$(jq -rs 'map(.error? // empty) | first // ""' \
    <<<"$bal"$'\n'"$paid"$'\n'"$unpaid" 2>/dev/null)

  # A key that exists is not the same as a key that works. `hasKey` drives
  # "is there anything to fix in the keyring", `authenticated` drives what the
  # panel says — a revoked key must read as NEEDS LOGIN, not as a network blip.
  local authed=true
  case $err in
  *unauthorized*) authed=false ;;
  esac

  jq -nc \
    --argjson authed "$authed" \
    --arg source "$key_source" \
    --arg env "${MAYAR_ENV:-production}" \
    --arg err "$err" \
    --argjson bal "$(jq -c '.data // null' <<<"$bal" 2>/dev/null || echo null)" \
    --argjson paid "$(normalise_paid <<<"$paid" 2>/dev/null || echo '[]')" \
    --argjson unpaid "$(normalise_unpaid <<<"$unpaid" 2>/dev/null || echo '[]')" \
    --argjson stale "$(jq -rs 'map(.stale? // false) | any' <<<"$bal"$'\n'"$paid"$'\n'"$unpaid" 2>/dev/null || echo false)" \
    '{hasKey:true, authenticated:$authed, source:$source, env:$env, keyringAvailable:true,
      balance:$bal, paid:$paid, unpaid:$unpaid,
      error:(if $err == "" then null else $err end), stale:$stale}'
  return 0
}

# ---------------------------------------------------------------------- main

FORCE=0
cmd=${1:-status}
shift 2>/dev/null

limit=10
while (($#)); do
  case $1 in
  -n | --limit)
    limit=${2:-10}
    shift 2
    ;;
  -f | --force)
    FORCE=1
    shift
    ;;
  *)
    shift
    ;;
  esac
done

case "$cmd" in
status) cmd_status "$limit" ;;
balance) cmd_balance ;;
paid) cmd_paid "$limit" ;;
unpaid) cmd_unpaid "$limit" ;;
auth) cmd_auth ;;
set-key | setkey) do_set_key ;;
logout) do_logout ;;
refresh)
  cache_drop
  echo "cache dropped"
  ;;
*) die "unknown command '$cmd' — try status, balance, paid, unpaid, auth, set-key, logout, refresh" ;;
esac
